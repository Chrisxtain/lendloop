# Copy to n8n/.env (git-ignored) and fill in. Used by docker-compose.yml and scripts/n8n-local.mjs.

# Your Convex HTTP actions URL (Convex dashboard > Settings > URL & Deploy Key, ends in .convex.site)
LENDLOOP_CONVEX_SITE_URL=https://your-deployment.convex.site
# Where the Next.js app runs (used for links in emails)
LENDLOOP_APP_URL=http://localhost:3000

# Convex -> n8n: n8n verifies the request-notification webhook with this.
# Must equal WEBHOOK_SIGNING_SECRET on Convex. Generate: openssl rand -hex 32
LENDLOOP_WEBHOOK_SECRET=
# n8n -> Convex: n8n signs calls to /automation/* with this.
# Must equal AUTOMATION_API_SECRET on Convex. Generate: openssl rand -hex 32
LENDLOOP_API_SECRET=

# Sender. Without a verified Resend domain only onboarding@resend.dev works.
NOTIFY_FROM=LendLoop <onboarding@resend.dev>
# Dev only: deliver every email here (Resend's test mode only delivers to your own address).
# Leave empty in production.
NOTIFY_OVERRIDE_TO=

# Encrypts credentials stored in n8n (the Resend API key). Generate: openssl rand -hex 24
N8N_ENCRYPTION_KEY=
