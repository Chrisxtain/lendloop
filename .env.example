# ---- Next.js app (.env.local) ----
# Written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Convex deployment env (set with `npx convex env set NAME value`, NOT in this file) ----
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, e.g. https://xxx.clerk.accounts.dev
# ADMIN_EMAILS              comma-separated emails that get the admin role (re-checked at every sign-in)
# N8N_NOTIFY_WEBHOOK_URL    n8n production webhook for request notifications
# WEBHOOK_SIGNING_SECRET    signs Convex -> n8n webhooks (= LENDLOOP_WEBHOOK_SECRET in n8n/.env)
# AUTOMATION_API_SECRET     verifies n8n -> Convex calls (= LENDLOOP_API_SECRET in n8n/.env)
