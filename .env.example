# ---- Next.js app (.env.local) ----
# Written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Convex deployment env (set with `npx convex env set NAME value`, NOT in this file) ----
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, e.g. https://xxx.clerk.accounts.dev
# ADMIN_EMAILS              comma-separated emails that get the admin role on first sign-in
# N8N_WEBHOOK_URL           n8n webhook for request notifications
# LENDLOOP_SIGNING_SECRET   shared HMAC secret (same value stored as an n8n credential)
